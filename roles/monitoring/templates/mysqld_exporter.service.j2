[Unit]
Description=Prometheus MySQL exporter
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
User=mysqld_exporter
ExecStart=/usr/local/bin/mysqld_exporter --config.my-cnf=/etc/mysqld_exporter/my.cnf --web.listen-address={{ monitoring_host_ip }}:9104
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
